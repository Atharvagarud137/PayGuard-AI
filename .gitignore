# ============================================================================
# PayGuard-AI .gitignore
# ============================================================================

# --- Python -----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.tox/
.nox/
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml

# --- Environment and secrets ------------------------------------------------
# Never commit real credentials. Commit .env.example instead.
.env
.env.*
!.env.example

# --- Frontend (dashboard/) --------------------------------------------------
node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test and browser-automation artifacts ----------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
.allure-results/

# --- Local databases and data -----------------------------------------------
*.sqlite3
*.sqlite
chroma_db/
pgdata/
postgres-data/

# --- Logs -------------------------------------------------------------------
*.log
logs/

# --- IDEs and editors -------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Operating systems ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Archives ---------------------------------------------------------------
*.zip

# --- Agent / scratch space --------------------------------------------------
.freebuff/

# --- Credential-bearing local reference material ----------------------------
# The recovered ChatGPT transcript contains the API key and encryption key that
# were pasted inline during the original conversation. It must stay local:
# committing it would publish those secrets. See docs/reference/.
docs/reference/payguard-ai-chatgpt-transcript.md
